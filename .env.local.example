# Manna Protocol v0 — environment variables
# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Anthropic API key for Claude Haiku 4.5
# Get one at https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model (default is claude-haiku-4-5-20251001)
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
